{
  "name": "mailerport-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mailerport-workspace",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "bin": {
        "app": "bin/app.js"
      }
    },
    "node_modules/@mailerport/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@mailerport/mime": {
      "resolved": "packages/mime",
      "link": true
    },
    "node_modules/@mailerport/sdk": {
      "resolved": "packages/sdk",
      "link": true
    },
    "node_modules/@mailerport/service": {
      "resolved": "packages/service",
      "link": true
    },
    "node_modules/@mailerport/smtp": {
      "resolved": "packages/smtp",
      "link": true
    },
    "node_modules/@mailerport/testing": {
      "resolved": "packages/testing",
      "link": true
    },
    "node_modules/mailerport": {
      "resolved": "packages/mailerport",
      "link": true
    },
    "packages/core": {
      "name": "@mailerport/core",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=20"
      }
    },
    "packages/mailerport": {
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@mailerport/core": "0.1.0",
        "@mailerport/sdk": "0.1.0"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/mime": {
      "name": "@mailerport/mime",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@mailerport/core": "0.1.0"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/sdk": {
      "name": "@mailerport/sdk",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@mailerport/core": "0.1.0"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/service": {
      "name": "@mailerport/service",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@mailerport/core": "0.1.0",
        "@mailerport/mime": "0.1.0",
        "@mailerport/smtp": "0.1.0"
      },
      "bin": {
        "mailport-service": "bin/mailport-service.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/smtp": {
      "name": "@mailerport/smtp",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@mailerport/core": "0.1.0",
        "@mailerport/mime": "0.1.0"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/testing": {
      "name": "@mailerport/testing",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@mailerport/core": "0.1.0"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
