NODE_ENV=production
PORT=8789
MAILPORT_URL=https://mail.example.com
MAILPORT_API_KEY=replace-with-application-secret
MAILPORT_ADMIN_KEY=replace-with-separate-admin-secret
MAILPORT_OUTBOX=/data/outbox.json
MAILPORT_OPERATIONS=/data/operations.json
MAILPORT_TRANSPORT=smtp
MAILPORT_SMTP_HOST=smtp.example.com
MAILPORT_SMTP_PORT=587
MAILPORT_SMTP_USERNAME=replace-with-smtp-user
MAILPORT_SMTP_PASSWORD=replace-with-secret-manager-value
MAILPORT_SMTP_REQUIRE_TLS=true
MAILPORT_DKIM_DOMAIN=example.com
MAILPORT_DKIM_PRIVATE_KEY=replace-with-secret-manager-value
MAILPORT_SHUTDOWN_TIMEOUT_MS=30000

NPM_TOKEN=