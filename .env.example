NODE_ENV=production
PORT=8789
MAILPORT_URL=https://mail.example.com
MAILPORT_API_KEY=replace-with-application-secret
MAILPORT_ADMIN_KEY=replace-with-separate-admin-secret
MAILPORT_OUTBOX=/data/outbox.json
MAILPORT_OPERATIONS=/data/operations.json
MAILPORT_TRANSPORT=smtp
MAILPORT_SMTP_HOST=smtp.example.com
MAILPORT_SMTP_PORT=587
MAILPORT_SMTP_USERNAME=replace-with-smtp-user
MAILPORT_SMTP_PASSWORD=replace-with-secret-manager-value
MAILPORT_SMTP_REQUIRE_TLS=true
MAILPORT_DKIM_DOMAIN=example.com
MAILPORT_DKIM_PRIVATE_KEY=replace-with-secret-manager-value
MAILPORT_DKIM_SELECTOR=mp1
MAILPORT_DKIM_CNAME_TARGETS=mp1.provider.example,mp2.provider.example
MAILPORT_SPF_VALUE=v=spf1 include:provider.example -all
MAILPORT_DMARC_VALUE=v=DMARC1; p=none; rua=mailto:dmarc@example.com
MAILPORT_SHUTDOWN_TIMEOUT_MS=30000
# Self-hosted direct-to-MX mode (use instead of MAILPORT_SMTP_*):
# MAILPORT_TRANSPORT=direct-mx
# MAILPORT_MTA_HOSTNAME=mail.example.com
# MAILPORT_EGRESS_IP=192.0.2.10
# MAILPORT_DIRECT_MX_WORKER_URL=https://mail.example.com
# MAILPORT_DELIVERY_TOKEN=replace-with-random-machine-token
# MAILPORT_EGRESS_IP_CHECK_URL=https://operator.example/observed-ip
# MAILPORT_ENVELOPE_FROM=bounces@example.com
# MAILPORT_SIGNING_KEYS=/data/signing-keys.json
# MAILPORT_KEY_ENCRYPTION_KEY=base64-encoded-32-byte-key
# MAILPORT_MTA_REQUIRE_TLS=false
# Cloudflare Email Service mode (use instead of MAILPORT_SMTP_*):
# MAILPORT_TRANSPORT=cloudflare
# MAILPORT_CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
# MAILPORT_CLOUDFLARE_API_TOKEN=replace-with-secret-manager-value
# MAILPORT_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4

NPM_TOKEN=
